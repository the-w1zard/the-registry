{
    "name": "@the-w1zard/the-registry",
    "version": "1.0.8",
    "sideEffects": false,
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "./src/index.d.ts"
    ],
    "scripts": {
        "1": "git add .",
        "2": "git commit -m \"first commit\"",
        "3": "git pull",
        "4": "git push",
        "5": "npm version patch",
        "6": "git push",
        "7": "git push --tags",
        "8": "npm publish --access public",
        "build": "tsc --emitDeclarationOnly && rspack build",
        "dev": "rspack serve",
        "check": "tsc --noEmit",
        "*": "npm run 1 && npm run 2 && npm run 3 && npm run 4 && npm run 5 && npm run 6 && npm run 7 && npm run 8"
    },
    "devDependencies": {
        "@babel/parser": "^8.1.2",
        "@babel/traverse": "^8.1.2",
        "@babel/types": "^8.1.2",
        "@rspack/cli": "^2.3.2",
        "@rspack/core": "^2.3.2",
        "@rspack/dev-server": "^2.2.2",
        "@the-w1zard/alias_types": "^1.0.8",
        "@the-w1zard/types": "^1.0.14",
        "@tsconfig/node-lts": "^24.0.1",
        "@types/node": "^24.19.2",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@the-w1zard/dx": "^1.0.27"
    },
    "imports": {
        "#STR": "@the-w1zard/app_store",
        "#tc": "./src/the-cloud.ts",
        "#the-cloud": "./src/the-cloud.ts",
        "#PRIM": "@the-w1zard/prims",
        "#sauron": "./src/index.ts",
        "#sr": "./src/sauron.ts",
        "#SS": "@the-w1zard/solutions",
        "#HPR": "@the-w1zard/prim_helpers"
    }
}
