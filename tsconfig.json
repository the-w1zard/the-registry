{
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022", "ES2021.WeakRef"],
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"allowJs": true,
		"strict": false,
		"noEmit": false,
		"isolatedModules": false,
		"skipLibCheck": true,
		"verbatimModuleSyntax": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node", "@the-w1zard/dx",  "@the-w1zard/alias_types", "@the-w1zard/types", "./src/index.d.ts"],
		"ignoreDeprecations": "6.0",
		"paths": {
			"~/*": ["./src/*"],
		}
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "dist",  "rspack.config.ts",  "sauron-rspack.ts"]
}
